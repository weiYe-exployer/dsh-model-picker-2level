{
  "name": "@local/dsh-model-picker-2level",
  "version": "0.1.5",
  "description": "Two-level model picker for DeepSeek Harness: choose a provider first, then one of its models.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "model-picker",
    "llm"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  },
  "devDependencies": {
    "jsdom": "26.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
