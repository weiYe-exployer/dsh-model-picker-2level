{
  "name": "@codewei823/dsh-model-picker-2level",
  "version": "0.1.6",
  "description": "Two-level model picker for DeepSeek Harness: choose a provider first, then one of its models.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "model-picker",
    "llm"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "docs/usage.md",
    "docs/testing.md",
    "docs/architecture.md",
    "docs/decisions.md",
    "docs/publishing.md",
    "docs/releases/v0.1.5.md",
    "docs/assets/*",
    "ROADMAP.md",
    "LICENSE",
    "docs/releases/v0.1.6.md"
  ],
  "scripts": {
    "validate": "node scripts/validate.mjs && node scripts/check-docs.mjs",
    "check:package": "node scripts/check-package.mjs",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20",
    "dsh": "0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  },
  "devDependencies": {
    "jsdom": "26.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "author": {
    "name": "codeWei",
    "url": "https://github.com/weiYe-exployer"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weiYe-exployer/dsh-model-picker-2level.git"
  },
  "homepage": "https://github.com/weiYe-exployer/dsh-model-picker-2level#readme",
  "bugs": {
    "url": "https://github.com/weiYe-exployer/dsh-model-picker-2level/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
